# Local development uses its existing defaults without this file.
# Production: load through systemd EnvironmentFile or node --env-file.
NODE_ENV=production
APP_ORIGIN=https://cup.example.com
APP_HOST=cup.example.com
API_PORT=3001
TRUSTED_PROXY=127.0.0.1
DATABASE_PATH=/var/lib/bracket/bracket.sqlite
RELEASE_ROOT=/opt/bracket/current
# Cloudflare Tunnel only: its service URL is http://127.0.0.1:8080.
PROXY_PORT=8080
