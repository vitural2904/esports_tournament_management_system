import Caddy.common

# Only cloudflared on this machine may reach this listener. Never bind publicly.
http://:{$PROXY_PORT:8080} {
	bind 127.0.0.1
	@wrongHost not host {$APP_HOST}
	@missingClient not header CF-Connecting-IP *
	route {
		respond @wrongHost 421
		respond @missingClient 400
		import bracket {http.request.header.CF-Connecting-IP}
	}
}
